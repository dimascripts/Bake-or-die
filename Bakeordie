-- Подсчет наггетсов
local function GetNuggetCount()
    local count = 0
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local character = LocalPlayer.Character
    
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            if item.Name:lower():find("nugget") or item.Name:lower():find("наггетс") then
                count = count + 1
            end
        end
    end
    if character then
        for _, item in pairs(character:GetChildren()) do
            if item:IsA("Tool") and (item.Name:lower():find("nugget") or item.Name:lower():find("наггетс")) then
                count = count + 1
            end
        end
    end
    return count
end

